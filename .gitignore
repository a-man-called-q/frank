/target
/fuzz/target
/xtask/target
.DS_Store
__pycache__/
*.py[cod]
bench/results/*.json
!bench/results/.gitkeep
/graphify-out/
/.moon/cache
/coverage/
*.lcov
/mutants.out*
/target/mutation/

# Local preview bundles, server data, and coverage scratch files.
/.frank-preview/
.env
/apps/frank_desktop/.env
/docker/tls/*.pem
/docker/tls/*.key
*.sqlite3
*.sqlite3-*
/safeio-cov.json
/dist/*
!/dist/.gitkeep
/dist/SHA256SUMS
/dist/*.tar.gz
/dist/*.zip
/dist/*.dmg
/dist/*.msi
/dist/*.deb
/dist/*.rpm

# cargo-fuzz writes every input that finds new coverage as a hash-named file
# with no extension -- exploration cache, not the curated seed corpus. The
# actual seeds (fuzz/corpus/*/malformed.toml etc.) all have a real extension,
# so re-include those explicitly and ignore everything else per target dir.
fuzz/corpus/*/*
!fuzz/corpus/*/*.*
