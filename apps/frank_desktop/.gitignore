.dart_tool/
.flutter-plugins-dependencies
.packages
.pub/
.idea/
*.iml
.metadata
build/
coverage/

# Flutter platform-generated files are committed only when the desktop target
# is enabled deliberately.
ios/
android/
web/
linux/
windows/

# Golden *failure* artifacts, written by flutter_test when a golden mismatches
# (isolatedDiff/maskedDiff/masterImage/testImage). These are build output for a
# red test, not baselines -- the baselines live alongside them in goldens/.
# Every suite that owns goldens gets its own failures/ dir (test/goldens/,
# test/organization/, test/team/, ...), so match the directory name anywhere
# under test/ rather than listing them one by one.
test/**/failures/
