{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "height": 720,
        "label": "main",
        "minHeight": 560,
        "minWidth": 720,
        "resizable": true,
        "title": "Frank",
        "width": 980
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "pnpm build",
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "externalBin": [
      "binaries/frank-sidecar"
    ],
    "icon": [
      "icons/icon.png",
      "icons/frank.svg"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/bin/frank": "packaging/frank"
        }
      },
      "rpm": {
        "files": {
          "/usr/bin/frank": "packaging/frank"
        }
      }
    },
    "longDescription": "Manage Frank modes, persona packs, and AI coding agent integrations.",
    "resources": {
      "packaging/frank": "frank-cli/frank",
      "packaging/frank.exe": "frank-cli/frank.exe",
      "packaging/install-frank-cli.command": "install-frank-cli.command"
    },
    "shortDescription": "Frank persona engine control panel",
    "targets": [
      "dmg",
      "msi",
      "deb",
      "rpm"
    ],
    "windows": {
      "wix": {
        "componentRefs": [
          "FrankCliPath"
        ],
        "fragmentPaths": [
          "./packaging/windows/frank-path.wxs"
        ]
      }
    }
  },
  "identifier": "dev.frank.desktop",
  "productName": "Frank",
  "version": "0.1.0"
}
