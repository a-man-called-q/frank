# Protected patterns are ordered from broad constructs to narrower nested
# constructs. A later range can only be contained by or equal to the current
# span; extending on `>` versus `>=` is therefore the same assignment, and the
# `==` variant only assigns the already-equal endpoint.
crates/frank-compress/src/rules.rs:78:26: replace > with >= in protected_spans
crates/frank-compress/src/rules.rs:78:26: replace > with == in protected_spans

# In the fence scanner, `i += 1` is the loop watchdog. `*= 1` is equivalent
# whenever i is positive; at the outer no-op path it can stall at zero, which
# is recorded as the intended timeout rather than a silently accepted result.
crates/frank-compress/src/validate.rs:103:15: replace += with *= in extract_code_blocks
crates/frank-compress/src/validate.rs:126:15: replace += with *= in extract_code_blocks

# When the bounded fingerprint has consumed MAX_CONFIG_BYTES, `>=` performs
# one zero-length read; it breaks immediately and adds no digest bytes, so it
# is behaviorally identical to `>`.
crates/frank-app/src/lib.rs:1179:25: replace > with >= in fingerprint_file_contents

