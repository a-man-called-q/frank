{
  "name": "frank-workspace",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "gui:dev": "pnpm --dir apps/frank-gui dev",
    "gui:test": "pnpm --dir apps/frank-gui test --coverage",
    "gui:build": "pnpm --dir apps/frank-gui build",
    "gui:lint": "pnpm --dir apps/frank-gui lint",
    "gui:typecheck": "pnpm --dir apps/frank-gui typecheck",
    "gui:e2e": "pnpm exec playwright test -c apps/frank-gui/playwright.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.52.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "3.2.7",
    "fast-check": "^4.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
